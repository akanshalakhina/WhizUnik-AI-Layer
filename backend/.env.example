# ---------------------------------------------------------------------------
# WhizUnik backend configuration.
# Copy to `.env` (development) and set real values in your deployment
# environment for production. NEVER commit a real .env file or API key.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Origin(s) allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:5173

# Secret used to sign login tokens. Must be long and random in production.
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=8h

# SQLite database file (WhizUnik's own database stays the source of truth).
DATABASE_PATH=./data/whizunik.db

# Demo data: seeds two demo clients + one user per role on first start.
# Must be false in production.
DEMO_MODE=true
SEED_PASSWORD=Demo@12345

# ---------------------------------------------------------------------------
# AI layer (Phase 1: advisory / read-only)
# ---------------------------------------------------------------------------
# Global kill switch. Individual clients also have their own feature flag.
AI_ENABLED=true

# openai  -> hosted OpenAI API (needs OPENAI_API_KEY)
# local   -> built-in deterministic rules engine (no external calls, no cost).
#            Used for development / offline demos and as a safe default when no
#            key is configured.
AI_PROVIDER=local

# The key is read ONLY on the server. It is never sent to the frontend.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Lower-cost model for routine summaries and searches.
AI_MODEL_FAST=gpt-4o-mini
# Stronger model for complex management analysis.
AI_MODEL_STRONG=gpt-4o

# Provider timeout and response limits.
AI_TIMEOUT_MS=20000
AI_MAX_QUESTION_CHARS=500
AI_MAX_RECORDS_PER_TOOL=25
AI_MAX_OUTPUT_TOKENS=1500

# Estimated price per 1M tokens in INR (ESTIMATES ONLY — verify the provider's
# current pricing before production launch).
AI_PRICE_FAST_INPUT_INR_PER_M=13
AI_PRICE_FAST_OUTPUT_INR_PER_M=53
AI_PRICE_STRONG_INPUT_INR_PER_M=220
AI_PRICE_STRONG_OUTPUT_INR_PER_M=880

# Cache the daily AI Management Summary for this many minutes.
AI_SUMMARY_CACHE_MINUTES=240

# Default per-client limits applied to newly created clients.
AI_DEFAULT_MONTHLY_COST_LIMIT_INR=2000
AI_DEFAULT_MONTHLY_REQUEST_LIMIT=1500
AI_DEFAULT_DAILY_USER_LIMIT=40
